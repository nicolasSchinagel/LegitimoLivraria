@using System.Globalization
@model List<(Livro livro, string arquivoImagem, string arquivoEbook, decimal mediaLivro, int numeroVendas, int quantidadeCarrinho)>
@{
    decimal totalCompra = 0;
}
<link rel="stylesheet" href="~/css/carrinho.css" asp-append-version="true" />

<main class="main-carrinho">
    <section class="main-carrinho-header">
        <div class="main-carrinho-header-item">
            <img src="~/img/KartA.png" class="main-carrinho-header-item-icon" />
            <h2 class="main-carrinho-header-item-text carrinhos-active">1.Carrinho</h2>
        </div>
        <div class="main-carrinho-header-item">
            <img src="~/img/LocalD.png" class="main-carrinho-header-item-icon" />
            <h2 class="main-carrinho-header-item-text carrinhos-inactive">2.Confirmar endereço</h2>
        </div>
        <div class="main-carrinho-header-item">
            <img src="~/img/BuyD.png" class="main-carrinho-header-item-icon" />
            <h2 class="main-carrinho-header-item-text carrinhos-inactive">3.Confirmar pagamento</h2>
        </div>
    </section>
    <section class="main-carrinho-content">
        <div class="main-carrinho-content-listaItens">
            @foreach(var item in Model)
            {
                <div class="main-carrinho-content-card">
                    <img src="@item.arquivoImagem" class="main-carrinho-content-card-img" />
                    <div class="main-carrinho-content-card-info">
                        <h2 class="main-carrinho-content-card-info-title">@item.livro.Nome - <span>@item.livro.Autor</span></h2>
                        <div class="main-carrinho-content-card-info-subinfo">
                            <div class="main-carrinho-content-card-info-subinfo-descriptions">
                                <h4 class="main-carrinho-content-card-info-subinfo-descriptions-editora">Editora: @item.livro.Editora</h4>
                                <h4 class="main-carrinho-content-card-info-subinfo-descriptions-tipo">@item.livro.TipoCapa</h4>
                                @if(item.livro.TipoCapa == "Ebook")
                                {
                                    <h5 class="main-carrinho-content-card-info-subinfo-descriptions-exemplares">Leitura por meio digital</h5>
                                }
                                else 
                                    @if(item.livro.Quantidade <= 20)
                                {
                                    <h5 class="main-carrinho-content-card-info-subinfo-descriptions-exemplares">Restam @item.livro.Quantidade exemplares disponíveis</h5>
                                }
                                else
                                {
                                    <h5 class="main-carrinho-content-card-info-subinfo-descriptions-exemplares"></h5>
                                }
                                
                            </div>
                            <div class="main-carrinho-content-card-info-subinfo-qtd">
                                <h4 class="main-carrinho-content-card-info-subinfo-off">@item.livro.PromocaoPorcentagem% off</h4>
                                <div class="main-carrinho-content-card-info-subinfo-qtd-block">
                                    <a asp-controller="Carrinho" asp-action="DiminuirQuantidade" asp-route-codBarras="@item.livro.CodigoBarras"><img class="qtd-block-minus" src="~/img/minus.png" /></a>
                                    <input type="number" class="main-carrinho-content-card-info-subinfo-qtd-block-input" value="@item.quantidadeCarrinho" />
                                    <a asp-controller="Carrinho" asp-action="AumentarQuantidade" asp-route-codBarras="@item.livro.CodigoBarras"><img class="qtd-block-plus" src="~/img/plus.png" /></a>
                                </div>
                            </div>
                            <div class="main-carrinho-content-card-info-subinfo-price">
                                @if(item.livro.PromocaoPorcentagem > 0)
                                {
                                    <h4 class="main-carrinho-content-card-info-subinfo-price-off">R$@item.livro.Preco</h4>
                                    <h3 class="main-carrinho-content-card-info-subinfo-price-now">R$@(Math.Round(decimal.Parse(item.livro.Preco, new CultureInfo("pt-BR")) * (1 - item.livro.PromocaoPorcentagem / 100m), 2).ToString("N2", new CultureInfo("pt-BR")))</h3>
                                }
                                else
                                {
                                    <h4 class="main-carrinho-content-card-info-subinfo-price-off"></h4>
                                    <h3 class="main-carrinho-content-card-info-subinfo-price-now">R$@item.livro.Preco</h3>
                                }
                                
                            </div>
                        </div>
                        <a asp-controller="Carrinho" asp-action="RemoverItem" asp-route-codBarras="@item.livro.CodigoBarras">
                        <img src="~/img/trash.png" class="main-carrinho-content-card-info-remove" />
                        </a>
                    </div>
                </div>
            }
        </div>
        <div class="main-carrinho-content-sobre">
            <h2 class="main-carrinho-content-sobre-title">Resumo da Compra</h2>
            <div class="main-carrinho-content-sobre-infos">
                <h3 class="main-carrinho-content-sobre-infos-frete">Frete: Grátis</h3>
                <h4 class="main-carrinho-content-sobre-infos-datapossivel">Datas possíveis de entrega:</h4>
                <h4 class="main-carrinho-content-sobre-infos-datas">De segunda-feira até quinta-feira</h4>
            </div>
            <div class="main-carrinho-content-sobre-lista">
                @foreach(var item in Model){
                    <div class="main-carrinho-content-sobre-lista-item">
                        <h3 class="main-carrinho-content-sobre-lista-item-title">@(item.livro.Nome.Length > 35 ? item.livro.Nome.Substring(0, 35) + "..." : item.livro.Nome)</h3>
                        <h3 class="main-carrinho-content-sobre-lista-item-number">x @item.quantidadeCarrinho</h3>
                        @if(item.livro.PromocaoPorcentagem > 0)
                        {
                            <h2 class="main-carrinho-content-sobre-lista-item-price">
                                @(
                                    Convert.ToDecimal(
                                        Math.Round(
                                            decimal.Parse(item.livro.Preco, new CultureInfo("pt-BR"))
                                            * (1 - item.livro.PromocaoPorcentagem / 100m),
                                            2
                                        ) * item.quantidadeCarrinho
                                    ).ToString("N2", CultureInfo.GetCultureInfo("pt-BR"))
                                )
                            </h2>
                        }
                        else
                        {
                            <h2 class="main-carrinho-content-sobre-lista-item-price">@((Convert.ToDecimal(item.livro.Preco) * item.quantidadeCarrinho).ToString("N2", CultureInfo.GetCultureInfo("pt-BR")))</h2>
                        }
                        
                    </div>
                    totalCompra = totalCompra + Convert.ToDecimal(Math.Round(
                                        decimal.Parse(item.livro.Preco, new CultureInfo("pt-BR"))
                                            * (1 - item.livro.PromocaoPorcentagem / 100m),
                                            2
                                        ) * item.quantidadeCarrinho) ;
                    
                    totalCompra.ToString("N2", CultureInfo.GetCultureInfo("pt-BR"));

                }
                <div class="main-carrinho-content-sobre-divisor"></div>
                <div class="main-carrinho-content-sobre-totals">
                    <h3 class="main-carrinho-content-sobre-totals-title">Total:</h3>
                    <h3 class="main-carrinho-content-sobre-totals-price">R$ @totalCompra.ToString("N2", CultureInfo.GetCultureInfo("pt-BR"))</h3>
                </div>
                <a class="main-carrinho-content-sobre-buttom">
                    <img src="~/img/cartCarrinho.png" class="main-carrinho-content-sobre-buttom-icon" />
                    <h3 class="main-carrinho-content-sobre-buttom-title">Finalizar Compra</h3>
                </a>
            </div>
        </div>
    </section>
</main>