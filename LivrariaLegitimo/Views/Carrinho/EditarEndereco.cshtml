@model LivrariaLegitimo.ViewModels.EnderecoViewModel

<link rel="stylesheet" href="~/css/carrinho.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/confEndereco.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/adicionarLivro.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/checkout.css" asp-append-version="true" />

<main class="main-carrinho">

    <section class="main-carrinho-header">

        <div class="main-carrinho-header-item">
            <img src="~/img/KartD.png" class="main-carrinho-header-item-icon" />
            <h2 class="main-carrinho-header-item-text carrinhos-inactive">1.Carrinho</h2>
        </div>

        <div class="main-carrinho-header-item">
            <img src="~/img/LocalA.png" class="main-carrinho-header-item-icon" />
            <h2 class="main-carrinho-header-item-text carrinhos-active">2.Confirmar endereço</h2>
        </div>

        <div class="main-carrinho-header-item">
            <img src="~/img/BuyD.png" class="main-carrinho-header-item-icon" />
            <h2 class="main-carrinho-header-item-text carrinhos-inactive">3.Confirmar pagamento</h2>
        </div>

    </section>

    @if (ViewBag.Erro != null)
    {
        <p class="checkout-mensagem-erro">@ViewBag.Erro</p>
    }

    @if (ViewBag.Sucesso != null)
    {
        <p class="checkout-mensagem-sucesso">@ViewBag.Sucesso</p>
    }

    <main class="addLivro-main">

        <section class="addLivro-main-form">

            <header class="confirmarEndereco-header">

                <div class="confirmarEndereco-header-title">

                    <img src="~/img/Mapping_icon.png"
                         class="confirmarEndereco-header-icon"
                         alt="" />

                    <h1>Antes de tudo, confirme o seu endereço</h1>

                </div>

                <p class="confirmarEndereco-header-subtitle">
                    Ajuste-o caso não esteja correto
                </p>

            </header>

            <form class="confirmarEndereco-content"
                  id="formEndereco"
                  asp-controller="Carrinho"
                  asp-action="EditarEndereco"
                  method="post">

                <div class="confirmarEndereco-columns">

                    <div class="addLivro-main-form-col-part">

                        <div class="input-div-type-1">

                            <div class="input-div-type-1-texts">
                                <label for="CEP" class="label-div-type-1">CEP</label>
                                <span class="obligate-div-type-1">*</span>
                            </div>

                            <div class="input-div-type-1-block">
                                <input type="text"
                                       asp-for="ObterCliente.Cep"
                                       name="CEP"
                                       id="CEP"
                                       class="input-div-type-1-block-insert"
                                       placeholder="Digite seu CEP"
                                       maxlength="8"
                                       required />
                            </div>

                        </div>

                        <div class="input-div-type-1">

                            <div class="input-div-type-1-texts">
                                <label for="estado" class="label-div-type-1">UF</label>
                                <span class="obligate-div-type-1">*</span>
                            </div>

                            <div class="input-div-type-5-block">

                                <select asp-for="ObterCliente.Estado"
                                        name="estado"
                                        id="estado"
                                        class="input-div-type-5-block-insert"
                                        required>

                                    <option value="" disabled>Selecione seu estado brasileiro</option>
                                    <option value="AC">AC</option>
                                    <option value="AL">AL</option>
                                    <option value="AP">AP</option>
                                    <option value="AM">AM</option>
                                    <option value="BA">BA</option>
                                    <option value="CE">CE</option>
                                    <option value="DF">DF</option>
                                    <option value="ES">ES</option>
                                    <option value="GO">GO</option>
                                    <option value="MA">MA</option>
                                    <option value="MT">MT</option>
                                    <option value="MS">MS</option>
                                    <option value="MG">MG</option>
                                    <option value="PA">PA</option>
                                    <option value="PB">PB</option>
                                    <option value="PR">PR</option>
                                    <option value="PE">PE</option>
                                    <option value="PI">PI</option>
                                    <option value="RJ">RJ</option>
                                    <option value="RN">RN</option>
                                    <option value="RS">RS</option>
                                    <option value="RO">RO</option>
                                    <option value="RR">RR</option>
                                    <option value="SC">SC</option>
                                    <option value="SP">SP</option>
                                    <option value="SE">SE</option>
                                    <option value="TO">TO</option>

                                </select>

                                <img src="~/img/expand_icon.png"
                                     class="input-div-type-2-block-expand"
                                     alt="" />

                            </div>

                        </div>

                        <div class="input-div-type-1">

                            <div class="input-div-type-1-texts">
                                <label for="cidade" class="label-div-type-1">Cidade</label>
                                <span class="obligate-div-type-1">*</span>
                            </div>

                            <div class="input-div-type-1-block">
                                <input type="text"
                                       asp-for="ObterCliente.Cidade"
                                       name="cidade"
                                       id="cidade"
                                       class="input-div-type-1-block-insert"
                                       placeholder="Digite o nome da sua cidade"
                                       required />
                            </div>

                        </div>

                        <div class="input-div-type-1">

                            <div class="input-div-type-1-texts">
                                <label for="bairro" class="label-div-type-1">Bairro</label>
                                <span class="obligate-div-type-1">*</span>
                            </div>

                            <div class="input-div-type-1-block">
                                <input type="text"
                                       asp-for="ObterCliente.Bairro"
                                       name="bairro"
                                       id="bairro"
                                       class="input-div-type-1-block-insert"
                                       placeholder="Digite o nome do seu bairro"
                                       required />
                            </div>

                        </div>

                        <a asp-controller="Carrinho"
                           asp-action="Carrinho"
                           class="confirmarEndereco-back">

                            <img src="~/img/arrowAddress_icon.png"
                                 class="back-address-icon" />

                            Voltar

                        </a>

                    </div>

                    <div class="addLivro-main-form-col-part">

                        <div class="input-div-type-1">

                            <div class="input-div-type-1-texts">
                                <label for="numeroEndereco" class="label-div-type-1">Número</label>
                                <span class="obligate-div-type-1">*</span>
                            </div>

                            <div class="input-div-type-1-block">
                                <input type="number"
                                       asp-for="ObterCliente.NumeroEndereco"
                                       name="numeroEndereco"
                                       id="numeroEndereco"
                                       class="input-div-type-1-block-insert"
                                       placeholder="Número do endereço"
                                       required />
                            </div>

                        </div>

                        <div class="input-div-type-1">

                            <div class="input-div-type-1-texts">
                                <label for="logradouro" class="label-div-type-1">Logradouro</label>
                                <span class="obligate-div-type-1">*</span>
                            </div>

                            <div class="input-div-type-1-block">
                                <input type="text"
                                       asp-for="ObterCliente.Logradouro"
                                       name="logradouro"
                                       id="logradouro"
                                       class="input-div-type-1-block-insert"
                                       placeholder="Digite o nome do logradouro"
                                       required />
                            </div>

                        </div>

                        <div class="input-div-type-1">

                            <div class="input-div-type-1-texts">
                                <label for="complementoEndereco" class="label-div-type-1">
                                    Complemento do endereço
                                </label>
                            </div>

                            <div class="input-div-type-1-block-long">
                                <textarea asp-for="ObterCliente.ComplementoEndereco"
                                          id="complementoEndereco"
                                          name="complementoEndereco"
                                          class="input-div-type-1-block-insertLong"
                                          rows="6"
                                          placeholder="Deixe aqui algo importante do seu endereço"></textarea>
                            </div>

                        </div>

                    </div>

                </div>

                <div class="addLivro-main-form-footer">

                    <button type="submit"
                            class="addLivro-main-form-footer-registrar">

                        <img src="~/img/correct_icon.png"
                             alt="✓"
                             class="confirmarEndereco-check" />

                        <h2 class="addLivro-main-form-footer-registrar-title">
                            ENDEREÇO CORRETO
                        </h2>

                    </button>

                    <a asp-controller="Carrinho"
                       asp-action="Carrinho"
                       class="addLivro-main-form-footer-cancelar">

                        <img src="~/img/closeAddress_icon.png"
                             alt="×"
                             class="confirmarEndereco-cancel-icon" />

                        <h3 class="addLivro-main-form-footer-cancelar-text">
                            CANCELAR
                        </h3>

                    </a>

                </div>

            </form>

        </section>

    </main>

</main>

<script>

    // ABERTURA DO SELECT DE ESTADO

    document.querySelectorAll(".input-div-type-2-block-expand").forEach(img => {

        let ativo = false;

        img.addEventListener("click", function() {

            const container = this.closest(".input-div-type-5-block");
            const select = container.querySelector(".input-div-type-5-block-insert");

            if (!ativo) {

                select.showPicker();
                ativo = true;

            } else {

                select.blur();
                ativo = false;

            }

        });

    });

</script>