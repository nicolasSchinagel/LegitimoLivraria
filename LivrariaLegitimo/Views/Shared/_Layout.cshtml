@inject LivrariaLegitimo.Libraries.Login.LoginCliente _LoginCliente
@inject LivrariaLegitimo.Libraries.Login.LoginFuncionario _LoginFuncionario

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LivrariaLegitimo</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/lateralMenu.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/header.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/footer.css" asp-append-version="true" />
</head>
<body>
    <header>
        <section class="uper-header">
            <img src="~/img/logoLivraria.png" class="logo-header">
            <div class="search-bar-header">
                <a class="icon-search-bar-font"><img src="~/img/SearchbarIcon.png" class="icon-search-bar"></a>
                <input type="text" class="input-search-bar" placeholder="Digite livros, autores ou editoras"/>
            </div>
            <a class="carrinho-header">
                <h2 class="tittle-carrinho-header">Carrinho de compras</h2>
                <div class="icon-carrinho-header">
                    <img src="~/img/CartIcon.png" class="image-icon-carrinho-header">
                    <h3 class="number-carrinho-header">1</h3>
                </div>
            </a>
            <div class="entry-header">
                @if(_LoginCliente.GetCliente() != null)
                {
                  <a class="tittle-login-header no-underline">@_LoginCliente.GetCliente().Nome</a>      
                }
                else @if(_LoginFuncionario.GetFuncionario() != null)
                {
                  <a class="tittle-login-header no-underline">@_LoginFuncionario.GetFuncionario().Nome</a>
                }
                else
                {
                  <a class="tittle-login-header no-underline" asp-action="Login" asp-controller="Default">Olá Sr. Anônimo</a>
                }
            </div>
        </section>
        <section class="deeper-header">
            <a class="font-deeper-header-menu"><img src="~/img/menuIcon.png" class="deeper-header-menu-icon"></a>
            <div class="main-items-deeper">
                <a class="main-items-deeper-text">Ofertas</a>
                <a class="main-items-deeper-text">Destaques</a>
                <a class="main-items-deeper-text">Lançamentos</a>
                <a class="main-items-deeper-text">Contato</a>
                <a class="main-items-deeper-text">Clássicos</a>
            </div>
            <a class="deeper-header-bonus">Bônus disponíveis</a>
        </section>
    </header>
    <div class="lateral-bar">
        <section class="lateral-bar-header">
            <div class="lateral-bar-userDiv">
                @if(_LoginCliente.GetCliente() != null)
                {
                    <img src="~/img/cliente_iconbar.png" class="lateral-bar-userDiv-image" />
                    <h2 class="lateral-bar-userDiv-name">@_LoginCliente.GetCliente().Nome</h2>
                }
                else if(_LoginFuncionario.GetFuncionario() != null)
                {
                    <img src="~/img/funcionario_iconbar.png" class="lateral-bar-userDiv-image" />
                    <h2 class="lateral-bar-userDiv-name">@_LoginFuncionario.GetFuncionario().Nome</h2>
                }
                else
                {
                    <img src="~/img/cliente_iconbar.png" class="lateral-bar-userDiv-image" />
                    <h2 class="lateral-bar-userDiv-name">Usuário não conectado</h2>
                }
                
            </div>
            <img src="~/img/leave_iconbar.png" class="lateral-bar-userDiv-leave" />
        </section>
            @if(_LoginFuncionario.GetFuncionario() != null)
            {
            <section class="lateral-bar-content">
                <div class="lateral-bar-content-block">
                    <h2 class="lateral-bar-content-block-title">Gerenciamentos</h2>
                    <div class="lateral-bar-content-block-list">
                        <a class="lateral-bar-content-block-list-item">Explorar gerenciamentos</a>
                            @if (_LoginFuncionario.GetFuncionario().Cargo == "administrador total" || _LoginFuncionario.GetFuncionario().Cargo == "gerente de compras")
                            {
                                <a class="lateral-bar-content-block-list-item">Adicionar Livro</a>
                            }
                            @if (_LoginFuncionario.GetFuncionario().Cargo == "administrador total" || _LoginFuncionario.GetFuncionario().Cargo == "gerente comercial" || _LoginFuncionario.GetFuncionario().Cargo == "caixa")
                            {
                                <a class="lateral-bar-content-block-list-item">Registrar Venda</a>
                            }
                            @if (_LoginFuncionario.GetFuncionario().Cargo == "administrador total" || _LoginFuncionario.GetFuncionario().Cargo == "gerente de compras")
                            {
                                <a class="lateral-bar-content-block-list-item">Fazer Reposição</a>  
                            }
                            @if (_LoginFuncionario.GetFuncionario().Cargo == "administrador total" || _LoginFuncionario.GetFuncionario().Cargo == "gerente de contratação")
                            {
                                <a class="lateral-bar-content-block-list-item">Cadastrar Funcionário</a>
                            }
                            @if (_LoginFuncionario.GetFuncionario().Cargo == "administrador total" || _LoginFuncionario.GetFuncionario().Cargo == "gerente comercial")
                            {
                                <a class="lateral-bar-content-block-list-item">Modificar Preços</a>
                            }
                            @if (_LoginFuncionario.GetFuncionario().Cargo == "administrador total" || _LoginFuncionario.GetFuncionario().Cargo == "gerente comercial" || _LoginFuncionario.GetFuncionario().Cargo == "caixa"){
                                <a class="lateral-bar-content-block-list-item">Cadastrar Cliente</a>
                            }
                        
                    </div>
                </div>
                
                <div class="lateral-bar-content-block">
                    <h2 class="lateral-bar-content-block-title">Configurações</h2>
                    <div class="lateral-bar-content-block-list">
                        <a class="lateral-bar-content-block-list-item no-underline" href="/Default/LogoutFuncionario">Sair</a>
                        <a class="lateral-bar-content-block-list-item">Dados</a>
                        <a class="lateral-bar-content-block-list-item">Editar Informações</a>
                    </div>
                </div>
            </section>
            }
            else
            {
            <section class="lateral-bar-content">
                <div class="lateral-bar-content-block">
                    <h2 class="lateral-bar-content-block-title">Destaques</h2>
                    <div class="lateral-bar-content-block-list">
                        <a class="lateral-bar-content-block-list-item">Mais vendidos</a>
                        <a class="lateral-bar-content-block-list-item">Ofertas do mês</a>
                        <a class="lateral-bar-content-block-list-item">Bem avaliados</a>
                    </div>
                </div>
                <div class="lateral-bar-content-block">
                    <h2 class="lateral-bar-content-block-title">Para você</h2>
                    <div class="lateral-bar-content-block-list">
                        <a class="lateral-bar-content-block-list-item">Histórico de Navegação</a>
                        <a class="lateral-bar-content-block-list-item">Minhas compras</a>
                        <a class="lateral-bar-content-block-list-item">Meus cupons</a>
                        <a class="lateral-bar-content-block-list-item">Avaliações disponíveis</a>
                        <a class="lateral-bar-content-block-list-item">Favoritos</a>
                    </div>
                </div>
                    @if(_LoginCliente.GetCliente != null)
                    {
                    <div class="lateral-bar-content-block">
                        <h2 class="lateral-bar-content-block-title">Configurações</h2>
                        <div class="lateral-bar-content-block-list">
                            <a class="lateral-bar-content-block-list-item no-underline" href="/Default/LogoutCliente">Sair</a>
                            <a class="lateral-bar-content-block-list-item">Dados</a>
                            <a class="lateral-bar-content-block-list-item">Editar Informações</a>
                        </div>
                    </div>
                    }
                </section>
            }
            
    </div>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer>
        <section class="footer-space-top"></section>
        <section class="footer-content">
            <div class="footer-topics">
                <h2 class="footer-topics-title">Sobre nós</h2>
                <div class="footer-topics-list">
                    <a class="footer-topics-link" >Legítimo</a>
                    <a class="footer-topics-link" >Créditos</a>
                    <a class="footer-topics-link" >Informações corporativas</a>
                    <a class="footer-topics-link" >Tecnologias</a>
                </div>
            </div>
            <div class="footer-topics">
                <h2 class="footer-topics-title">Coopere conosco</h2>
                <div class="footer-topics-list">
                    <a class="footer-topics-link" >Doe livros usados</a>
                    <a class="footer-topics-link" >Seja um fornecedor</a>
                    <a class="footer-topics-link" >Avalie livros comprados</a>
                    <a class="footer-topics-link" >Doe dinheiro</a>
                </div>
            </div>
            <div class="footer-topics-center">
                <a class="footer-topics-center-backstart">Voltar ao início</a>
                <img src="~/img/iconFooter.png" class="footer-topics-center-icon"/>
            </div>
            <div class="footer-topics">
                <h2 class="footer-topics-title">Pagamento</h2>
                <div class="footer-topics-list">
                    <a class="footer-topics-link" >Meios de pagamento</a>
                    <a class="footer-topics-link" >Bônus disponíveis</a>
                    <a class="footer-topics-link" >Termos e condições</a>
                </div>
            </div>
            <div class="footer-topics">
                <h2 class="footer-topics-title">Contato</h2>
                <div class="footer-topics-list">
                    <a class="footer-topics-link" >Ajuda por telefone</a>
                    <a class="footer-topics-link" >Visite a loja física</a>
                    <a class="footer-topics-link" >Frete e prazo de entrega</a>
                    <a class="footer-topics-link" >Reembolsos</a>
                </div>
            </div>
        </section>
        <section class="footer-foot">
            <h2 class="footer-foot-line"> <span class="footer-foot-span">Condições de uso</span> | <span class="footer-foot-span">Cookies</span> | <span class="footer-foot-span">@@2026 Legitimolivros.com</span></h2>
        </section>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script>
            const lateralBar = document.querySelector('.lateral-bar');
            const lateralBarLeave = document.querySelector('.lateral-bar-userDiv-leave');
            const headerMenu = document.querySelector('.deeper-header-menu-icon');

            lateralBarLeave.addEventListener('click', () => {
                lateralBar.style.left = '-35%';
            });
            headerMenu.addEventListener('click', () => {
                lateralBar.style.left = '0%';
            });
    </script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
