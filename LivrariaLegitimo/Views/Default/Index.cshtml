@inject LivrariaLegitimo.Repository.LivroRepository _livroRepository
@model LivrariaLegitimo.ViewModels.LivroViewModel
@{
    ViewData["Title"] = "Home Page";
    int indiceLivro = 1;
}
<link rel="stylesheet" href="~/css/index.css" asp-append-version="true" />
<div class="div-menu">
    <div class="space-index-banner">
        <div class="track">
            <div class="outside active">
                <div class="banner-livraria">
                    <img src="~/img/bi-1.webp" alt="Banner 1" class="banner-image">
                </div>
            </div>
            <div class="outside">
                <div class="banner-livraria">
                    <img src="~/img/bi-2.webp" alt="Banner 2" class="banner-image">

                </div>
            </div>
            <div class="outside">
                <div class="banner-livraria">
                    <img src="~/img/bi-3.webp" alt="Banner 3" class="banner-image">

                </div>
            </div>
            <div class="outside">
                <div class="banner-livraria">
                    <img src="~/img/bi-4.webp" alt="Banner 4" class="banner-image">

                </div>
            </div>
            <div class="outside">
                <div class="banner-livraria">
                    <img src="~/img/bi-5.webp" alt="Banner 5" class="banner-image">

                </div>
            </div>
        </div>
        <div class="arrows">
            <img src="~/img/arrow-right.png" class="banner-next">
            <img src="~/img/arrow-left.png" class="banner-prev">
        </div>
        <div class="balls">
            <div class="ball ball-active"></div>
            <div class="ball"></div>
            <div class="ball"></div>
            <div class="ball"></div>
            <div class="ball"></div>
        </div>
    </div>
</div>
<div class="div-cards-init">
    <div class="card-init">
        <h2 class="card-init-title">Continue de onde parou</h2>
        @if(Model.HistoricoG.Count() > 0)
        {
            <section class="books-card-init">
            @foreach(var livro in Model.HistoricoG.Take(2))
            {
                <a class="book-card-init no-underline" asp-controller="Livro" asp-action="Livro" asp-route-codBarras="@livro.livro.CodigoBarras">
                    <img src="@livro.arquivoImagem" class="image-book-card-init">
                    <h4 class="title-book-card-init">@livro.livro.Nome</h4>
                </a>
            }
            </section>
        }
        else
        {
            <section class="books-card-init">
                <h3>Explore para aparecer</h3>
            </section>
        }
        <section class="ver-todos-card-init">
            <h3 class="ver-todos-card-init-text">Ver todos</h3>
            <img src="~/img/verTodos.png" class="ver-todos-icon">
        </section>

    </div>
    <div class="card-init">
        <h2 class="card-init-title">Talvez você goste</h2>
        <section class="books-card-init">
            @foreach(var livro in Model.Aleatorios.Take(2))
            {
                <a class="book-card-init no-underline" asp-controller="Livro" asp-action="Livro" asp-route-codBarras="@livro.livro.CodigoBarras">
                    <img src="@livro.arquivoImagem" class="image-book-card-init">
                    <h4 class="title-book-card-init">@livro.livro.Nome</h4>
                </a>
            }
        </section>
    </div>
    <div class="card-init">
        <h2 class="card-init-title">Ofertas do mês</h2>
        <section class="books-card-init">
            @foreach(var livro in Model.MaioresOfertas)
            {
                <a class="book-card-init no-underline" asp-controller="Livro" asp-action="Livro" asp-route-codBarras="@livro.livro.CodigoBarras">
                    <img src="@livro.arquivoImagem" class="image-book-card-init">
                    <h4 class="title-book-card-init">@livro.livro.Nome</h4>
                    <h5 class="discount-book-card-init"><span class="discount-book-card-init-span">@livro.livro.PromocaoPorcentagem %</span> de desconto</h5>
                </a>
            }
        </section>
        <section class="ver-todos-card-init">
            <h3 class="ver-todos-card-init-text">Ver todos</h3>
            <img src="~/img/verTodos.png" class="ver-todos-icon">
        </section>
    </div>
</div>
<div class="div-cards-carousel">
    <div class="top-bar-cards">
        <h2 class="top-bar-cards-title">Bem avaliados</h2>
        <section class="ver-todos-top-bar-cards">
            <h3 class="ver-todos-card-init-text">Ver todos</h3>
            <img src="~/img/verTodos.png" class="ver-todos-icon">
        </section>
    </div>

    <div class="div-cards-carousel-index-0">
        @foreach(var livro in Model.BemAvaliados)
        {
            <div class="card1 no-underline">
                <a class="no-underline" asp-controller="Livro" asp-action="Livro" asp-route-codBarras="@livro.livro.CodigoBarras">
                <div class="containerlivro">
                    <img class="book" src="@livro.arquivoImagem">

                    <div class="retangulocimaBemavaliado">
                        <img class="imgetiqueta" src="~/img/bemavaliado.png">
                        <p class="bemavaliado">BEM AVALIADO</p>
                    </div>
                </div>


                <div class="partebaixo">
                    <div class="tituloeheart">
                        <h2 class="titulolivro">@(livro.livro.Nome.Length > 37 ? livro.livro.Nome.Substring(0, 37) + "..." : livro.livro.Nome)</h2>
                        <div class="heartfundo">
                            <img class="heart" src="~/img/coracaored.png">
                        </div>
                    </div>
                    <p class="autor">Por @livro.livro.Autor</p>
                    <p class="editor">@livro.livro.Editora</p>
                    <div class="estrelas">
                        <div class="estrelas-specifics">
                            <img class="estrelasimg" src="~/img/StarComb.png">
                            <div class="estrelas-specifics-yellowbar" style="width: @((livro.mediaLivro / 5m * 100).ToString(CultureInfo.InvariantCulture))%;"></div>
                        </div>
                        <h3 class="avaliados">(@livro.mediaLivro)</h3>
                        <img class="setabaixo" src="~/img/setabaixo.png">
                    </div>
                    @using System.Globalization
                    @if(livro.livro.PromocaoPorcentagem <= 0)
                    {
                        <h3 class="precoog"></h3>
                    }
                    else
                    {
                        <h3 class="precoog">R$ @livro.livro.Preco</h3>
                    }
                    <div class="precoDiv">
                        @if(livro.livro.PromocaoPorcentagem <= 0)
                        {
                            <h2 class="preco">R$ @livro.livro.Preco</h2>
                            <h2 class="off"></h2>
                        }
                        else{
                         <h2 class="preco">R$ @(Math.Round( decimal.Parse(livro.livro.Preco, new CultureInfo("pt-BR")) * (1 - livro.livro.PromocaoPorcentagem / 100m), 2).ToString("N2", new CultureInfo("pt-BR")))
                        </h2>
                        <h2 class="off">@livro.livro.PromocaoPorcentagem% OFF</h2>
                        }
                    </div>
                </div>
                </a>
                <a class="cartCamada no-underline" asp-controller="Carrinho" asp-action="AdicionarItem" asp-route-codBarras="@livro.livro.CodigoBarras">
                    <div class="addcartretangulo">
                        <img class="carrinho" src="~/img/cart.png">
                        <h2>Adicionar ao carrinho</h2>
                    </div>
                </a>
            </div>
        }
    </div>
</div>
<div class="div-cards-carousel">
    <div class="top-bar-cards">
        <h2 class="top-bar-cards-title">Mais vendidos</h2>
        <section class="ver-todos-top-bar-cards">
            <h3 class="ver-todos-card-init-text">Ver todos</h3>
            <img src="~/img/verTodos.png" class="ver-todos-icon">
        </section>
    </div>
    <div class="div-cards-carousel-static">
        <div class="arrows-carousel-div">
            <img src="~/img/arrow-carousel.png" class="arrow-carousel-left-1">
            <img src="~/img/arrow-carousel.png" class="arrow-carousel-right-1">
        </div>
        <div class="div-cards-carousel-total-1">
            @foreach(var grupo in Model.MaisVendidos.Chunk(5))
            {
                <div class="div-cards-carousel-index-1">
                    @foreach(var livro in grupo)
                    {
                        <div class="card1 no-underline">
                            <a class="no-underline" asp-controller="Livro" asp-action="Livro" asp-route-codBarras="@livro.livro.CodigoBarras">
                            <div class="containerlivro">
                                <img class="book" src="@livro.arquivoImagem">

                                <div class="retangulocima">
                                    <img class="imgetiqueta" src="~/img/iconefogo.png">
                                    <p class="alta">EM ALTA</p>
                                </div>
                                <div class="card-1-enumerado">
                                    <h3 class="card-1-enumerado-numero">@indiceLivro</h3>
                                </div>
                            </div>


                            <div class="partebaixo">
                                <div class="tituloeheart">
                                    <h2 class="titulolivro">@(livro.livro.Nome.Length > 37 ? livro.livro.Nome.Substring(0, 37) + "..." : livro.livro.Nome)</h2>
                                    <div class="heartfundo">
                                        <img class="heart" src="~/img/coracaored.png">
                                    </div>
                                </div>

                                <p class="autor">Por @livro.livro.Autor</p>
                                <p class="editor">@livro.livro.Editora</p>
                                <div class="estrelas">
                                    <div class="estrelas-specifics">
                                        <img class="estrelasimg" src="~/img/StarComb.png">
                                        <div class="estrelas-specifics-yellowbar" style="width: @((livro.mediaLivro / 5m * 100).ToString(CultureInfo.InvariantCulture))%;"></div>
                                    </div>
                                    <h3 class="avaliados">(@livro.mediaLivro)</h3>
                                    <img class="setabaixo" src="~/img/setabaixo.png">
                                </div>
                                @if (livro.livro.PromocaoPorcentagem <= 0)
                                {
                                    <h3 class="precoog"></h3>
                                }
                                else
                                {
                                    <h3 class="precoog">R$ @livro.livro.Preco</h3>
                                }
                                <div class="precoDiv">
                                    @if (livro.livro.PromocaoPorcentagem <= 0)
                                    {
                                        <h2 class="preco">R$ @livro.livro.Preco</h2>
                                        <h2 class="off"></h2>
                                    }
                                    else
                                    {
                                        <h2 class="preco">
                                            R$ @(Math.Round(decimal.Parse(livro.livro.Preco, new CultureInfo("pt-BR")) * (1 - livro.livro.PromocaoPorcentagem / 100m), 2).ToString("N2", new CultureInfo("pt-BR")))
                                        </h2>
                                        <h2 class="off">@livro.livro.PromocaoPorcentagem% OFF</h2>
                                    }
                                </div>
                            </div>
                            </a>
                            <a class="cartCamada no-underline" asp-controller="Carrinho" asp-action="AdicionarItem" asp-route-codBarras="@livro.livro.CodigoBarras">
                                <div class="addcartretangulo no-underline">
                                    <img class="carrinho" src="~/img/cart.png">
                                    <h2>Adicionar ao carrinho</h2>
                                </div>
                            </a>
                        </div>
                        indiceLivro++;
                    }
                    
                </div>
            }
        </div>
    </div>
</div>
