    </div>
</div>
<div class="div-cards-carousel">
    <div class="top-bar-cards">
        <h2 class="top-bar-cards-title">Histórico geral</h2>
        <section class="parts-card">
        </section>
        <h4 class="top-bar-cards-pages">página <span class="start-page-top-bar-4-1">1</span> de <span class="total-pages-top-bar-4-2">5</span></h4>
    </div>
    <div class="div-cards-carousel-static">
        <div class="arrows-carousel-div">
            <img src="~/img/arrow-carousel.png" class="arrow-carousel-left-4">
            <img src="~/img/arrow-carousel.png" class="arrow-carousel-right-4">
        </div>
        <div class="div-cards-carousel-total-4">
            @foreach(var grupo in Model.HistoricoG.Chunk(3))
            {
                <div class="div-cards-carousel-index-4">
                    @foreach(var livro in grupo)
                    {
                        <div class="banner2">
                            @if (livro.livro.DataPubli.Year == DateTime.Now.Year)
                            {
                                <div class="retangulocimaNovo-historico">
                                    <img class="imgetiqueta" src="~/img/novo.png">
                                    <p class="novo">NOVO</p>
                                </div>
                            }
                            else if (_livroRepository.EmAlta(livro.livro.CodigoBarras.ToString()))
                            {
                                <div class="retangulocima-historico">
                                    <img class="imgetiqueta" src="~/img/iconefogo.png">
                                    <p class="alta">EM ALTA</p>
                                </div>
                            }
                            else if (Convert.ToDouble(livro.mediaLivro) >= 4.0)
                            {
                                <div class="retangulocimaBemavaliado-historico">
                                    <img class="imgetiqueta" src="~/img/bemavaliado.png">
                                    <p class="bemavaliado">BEM AVALIADO</p>
                                </div>
                            }
                            <img class="livro-historico" src="@livro.arquivoImagem">
                            <div class="partelateral-historico">
                                <h1 class="titulo-historico">@(livro.livro.Nome.Length > 37 ? livro.livro.Nome.Substring(0, 37) + "..." : livro.livro.Nome)</h1>
                                <h2 class="autor-historico">Por @livro.livro.Autor</h2>
                                <h2 class="editor-historico">@livro.livro.Editora</h2>

                                <div class="estrelas-historico">
                                    <div class="estrelas-historico-specifics">
                                        <img class="estrelasimg-historico" src="~/img/StarComb.png">
                                        <div class="estrelas-specifics-yellowbar" style="width: @((livro.mediaLivro / 5m * 100).ToString(CultureInfo.InvariantCulture))%;"></div>
                                    </div>
                                    <h3 class="avaliados-historico">(@(livro.mediaLivro))</h3>
                                    <img class="setabaixo-historico" src="~/img/setabaixo.png">
                                </div>

                                <div class="partedebaixo-historico">
                                    <h1 class="preco-historico">R$ @livro.livro.Preco</h1>

                                    <div class="quadradosred-historico">
                                        <div class="cartfundo-historico">
                                            <img class="cart-historico" src="~/img/cart.png">
                                        </div>

                                        <div class="heartfundo-historico">
                                            <img class="heart-historico" src="~/img/coracaored.png">
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }

        </div>
    </div>
</div>


<script>
    document.addEventListener("DOMContentLoaded", () => {
        const totalList1 = document.querySelector(".div-cards-carousel-total-1");
        const listCards1 = document.querySelectorAll(".div-cards-carousel-index-1");
        const prevlist1 = document.querySelector(".arrow-carousel-left-1");
        const nextlist1 = document.querySelector(".arrow-carousel-right-1");

        const totalList2 = document.querySelector(".div-cards-carousel-total-2");
        const listCards2 = document.querySelectorAll(".div-cards-carousel-index-2");
        const prevlist2 = document.querySelector(".arrow-carousel-left-2");
        const nextlist2 = document.querySelector(".arrow-carousel-right-2");
        const valueMin2 = document.querySelector(".start-page-top-bar-2-1");
        const valueMax2 = document.querySelector(".total-pages-top-bar-2-2");

        const totalList3 = document.querySelector(".div-cards-carousel-total-3");
        const listCards3 = document.querySelectorAll(".div-cards-carousel-index-3");
        const prevlist3 = document.querySelector(".arrow-carousel-left-3");
        const nextlist3 = document.querySelector(".arrow-carousel-right-3");
        const valueMin3 = document.querySelector(".start-page-top-bar-3-1");
        const valueMax3 = document.querySelector(".total-pages-top-bar-3-2");

        const totalList4 = document.querySelector(".div-cards-carousel-total-4");
        const listCards4 = document.querySelectorAll(".div-cards-carousel-index-4");
        const prevlist4 = document.querySelector(".arrow-carousel-left-4");
        const nextlist4 = document.querySelector(".arrow-carousel-right-4");
        const valueMin4 = document.querySelector(".start-page-top-bar-4-1");
        const valueMax4 = document.querySelector(".total-pages-top-bar-4-2");
        const divPartsCard = document.querySelector(".parts-card");

        const lateralBar = document.querySelector('.lateral-bar');
        const lateralBarLeave = document.querySelector('.lateral-bar-userDiv-leave');
        const headerMenu = document.querySelector('.deeper-header-menu-icon');


        const track = document.querySelector(".track");
        const next = document.querySelector(".banner-next");
        const prev = document.querySelector(".banner-prev");
        const balls = document.querySelectorAll(".ball");
        let indiceBola = 0;
        let indicePage1 = 0;
        let posicaoPage1 = 0;
        let indicePage2 = 0;
        let posicaoPage2 = 0;
        let indicePage3 = 0;
        let posicaoPage3 = 0;
        let indicePage4 = 0;
        let posicaoPage4 = 0;
        let animando = false;
        function atualizarPagina1() {
            console.log('ativado');
            if (indicePage1 >= listCards1.length - 1) {
                nextlist1.style.visibility = 'hidden';
            } else {
                nextlist1.style.visibility = 'visible';
                console.log(listCards1.length);
            }

            if (indicePage1 <= 0) {
                prevlist1.style.visibility = 'hidden';
                console.log('ativado prev');
            } else {
                prevlist1.style.visibility = 'visible';
            }
        }

        atualizarPagina1();
        prevlist1.addEventListener("click", () => {
            indicePage1 = indicePage1 - 1;
            posicaoPage1 = posicaoPage1 - 100;
            totalList1.style.right = posicaoPage1 + '%';
            atualizarPagina1();
        });
        nextlist1.addEventListener("click", () => {
            indicePage1 = indicePage1 + 1;
            posicaoPage1 = posicaoPage1 + 100;
            totalList1.style.right = posicaoPage1 + '%';
            atualizarPagina1();
        });




        function atualizarPagina2() {
            console.log('ativado');
            if (indicePage2 >= listCards2.length - 1) {
                nextlist2.style.visibility = 'hidden';
            } else {
                nextlist2.style.visibility = 'visible';
                console.log(listCards2.length);
            }

      
            if (indicePage2 <= 0) {
                prevlist2.style.visibility = 'hidden';
                console.log('ativado prev');
            } else {
                prevlist2.style.visibility = 'visible';
            }
            valueMax2.textContent = listCards2.length;
            valueMin2.textContent = indicePage2 + 1;
        }

        atualizarPagina2();
        prevlist2.addEventListener("click", () => {
            indicePage2 = indicePage2 - 1;
            posicaoPage2 = posicaoPage2 - 100;
            totalList2.style.right = posicaoPage2 + '%';
            atualizarPagina2();
        });
        nextlist2.addEventListener("click", () => {
            indicePage2 = indicePage2 + 1;
            posicaoPage2 = posicaoPage2 + 100;
            totalList2.style.right = posicaoPage2 + '%';
            atualizarPagina2();
        });
        console.log(valueMax2);

     

        function atualizarPagina3() {
            console.log('ativado');
            if (indicePage3 >= listCards3.length - 1) {
                nextlist3.style.visibility = 'hidden';
            } else {
                nextlist3.style.visibility = 'visible';
                console.log(listCards3.length);
            }

      
            if (indicePage3 <= 0) {
                prevlist3.style.visibility = 'hidden';
                console.log('ativado prev');
            } else {
                prevlist3.style.visibility = 'visible';
            }
            valueMax3.textContent = listCards3.length;
            valueMin3.textContent = indicePage3 + 1;
        }

        atualizarPagina3();
        prevlist3.addEventListener("click", () => {
            indicePage3 = indicePage3 - 1;
            posicaoPage3 = posicaoPage3 - 100;
            totalList3.style.right = posicaoPage3 + '%';
            atualizarPagina3();
        });
        nextlist3.addEventListener("click", () => {
            indicePage3 = indicePage3 + 1;
            posicaoPage3 = posicaoPage3 + 100;
            totalList3.style.right = posicaoPage3 + '%';
            atualizarPagina3();
        });


        for (let i = 1; i <= listCards4.length; i++) {
            const pinsindices = document.createElement("div");
            pinsindices.classList.add("part-cards");
            divPartsCard.appendChild(pinsindices);
            console.log("rodado");
        }
        const pinsindices = document.querySelectorAll(".part-cards");

        function atualizarPins() {
            pinsindices.forEach((pin, index) => {
                if (index === indicePage4) {
                    pin.classList.add("selected-part");
                }
                else {
                    pin.classList.remove("selected-part");
                }
            })
        }

        function atualizarPagina4() {
            console.log('ativado');
            if (indicePage4 >= listCards4.length - 1) {
                nextlist4.style.visibility = 'hidden';
            } else {
                nextlist4.style.visibility = 'visible';
                console.log(listCards4.length);
            }

      
            if (indicePage4 <= 0) {
                prevlist4.style.visibility = 'hidden';
                console.log('ativado prev');
            } else {
                prevlist4.style.visibility = 'visible';
            }
            atualizarPins();
            valueMax4.textContent = listCards4.length;
            valueMin4.textContent = indicePage4 + 1;
        }

        atualizarPagina4();
        prevlist4.addEventListener("click", () => {
            indicePage4 = indicePage4 - 1;
            posicaoPage4 = posicaoPage4 - 100;
            totalList4.style.right = posicaoPage4 + '%';
            atualizarPagina4();
        });
        nextlist4.addEventListener("click", () => {
            indicePage4 = indicePage4 + 1;
            posicaoPage4 = posicaoPage4 + 100;
            totalList4.style.right = posicaoPage4 + '%';
            atualizarPagina4();
        });
        pinsindices.forEach((elemento, index) => {
            elemento.addEventListener("click", () => {
                indicePage4 = index;
                posicaoPage4 = 100 * index;
                totalList4.style.right = posicaoPage4 + '%';
                atualizarPagina4();
                console.log("clicado");
            })
        });

     

        function atualizarBolas() {
            if (indiceBola >= balls.length) {
                indiceBola = 0;
            }
            else if (indiceBola < 0) {
                indiceBola = balls.length - 1;
            }
            balls.forEach((ball, index) => {
                if (index === indiceBola) {
                    ball.classList.add("ball-active");
                } else {
                    ball.classList.remove("ball-active");
                }
            });
        }
        function proximoBanner() {

            if (animando) return;

            animando = true;

            track.style.transform = "translateX(-100%)";

            track.addEventListener("transitionend", function fim() {

                track.appendChild(track.firstElementChild);

                track.style.transition = "none";
                track.style.transform = "translateX(0)";

                track.offsetHeight;

                track.style.transition = "transform .6s ease-in-out";

                animando = false;

                track.removeEventListener("transitionend", fim);
            });
            clearInterval(intervalo);
            iniciarIntervalo();
            indiceBola++;
            atualizarBolas();
        }

        next.addEventListener("click", proximoBanner);

        function voltarBanner() {

            if (animando) return;

            animando = true;

            track.style.transition = "none";

            track.prepend(track.lastElementChild);

            track.style.transform = "translateX(-100%)";

            track.offsetHeight;

            track.style.transition = "transform .6s ease-in-out";

            requestAnimationFrame(() => {
                track.style.transform = "translateX(0)";
            });

            track.addEventListener("transitionend", function fim() {

                animando = false;

                track.removeEventListener("transitionend", fim);

            });

            indiceBola--;

            atualizarBolas();

            clearInterval(intervalo);
            iniciarIntervalo();
        }

        prev.addEventListener("click", voltarBanner);
        let intervalo;
        // PASSAGEM AUTOMÁTICA
        function iniciarIntervalo() {
            intervalo = setInterval(() => {
                proximoBanner();
            }, 5000);
        }
        iniciarIntervalo();


        balls.forEach((ball, index) => {
            ball.addEventListener("click", () => {

                console.log("clicou");

                if (index === indiceBola) return;

                clearInterval(intervalo);

                track.style.transition = "none";

                while (indiceBola !== index) {

                    if (indiceBola < index) {
                        track.appendChild(track.firstElementChild);
                        indiceBola++;
                    }
                    else {
                        track.prepend(track.lastElementChild);
                        indiceBola--;
                    }
                }

                track.style.transform = "translateX(0)";

                atualizarBolas();

                iniciarIntervalo();
                track.style.transition = "";
            });
        });


    });
</script>