                        <h1 class="titulo-e">Pense duas vezes (Myron Bolitar)</h1>
                        <h2 class="autor-e">Por Harlan Coben</h2>
                        <h2 class="editor-e">Pomodoro Books</h2>

                        <div class="barraprogresso">
                            <div class="barraprogresso2"></div>
                        </div>

                        <h2 class="porcentagemtext">50% lido</h2>

                        <div class="continarlendo">
                            <img class="livrolendo" src="~/img/livrozinlogo.png">
                            <h2 class="continuarlendotext">Continuar lendo</h2>
                        </div>
                    </div>
                </div>

                <!-- Banner Procurar -->
                <div class="formato-banner-ebook bannerprocurar">
                    <div class="wrapperprocurar">
                        <img class="mais" src="~/img/simbolomais.png">
                        <div class="textsmais">
                            <h1 class="procurarebookstext">Procurar e-books</h1>
