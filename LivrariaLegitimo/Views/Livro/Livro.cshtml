<div class="main-book">
    <section class="cover-section">
        <img src="@Model.ObterLivro.arquivoImagem" class="cover-section-image" />
        <h3 class="cover-section-more">Mais sobre o autor</h3>
        <h2 class="cover-section-author">@Model.ObterLivro.livro.Autor</h2>
    </section>
    <section class="section-descriptions">
        <div class="section-descriptions-top">
            <div class="section-descriptions-top-names">
                <h1 class="section-descriptions-nomeLivro">@Model.ObterLivro.livro.Nome</h1>
                <div class="section-descriptions-top-names-caracteristicas">
                    <h3 class="section-descriptions-top-names-atribute-1">Edição: <span>@Model.ObterLivro.livro.Idioma</span></h3>
                    <h4 class="section-descriptions-top-names-divisor">|</h4>
                    <h3 class="section-descriptions-top-names-atribute-1">Tipo: <span>@Model.ObterLivro.livro.TipoCapa</span></h3>
                    <h4 class="section-descriptions-top-names-divisor">|</h4>
                    <h3 class="section-descriptions-top-names-atribute-1">Editora: <span>@Model.ObterLivro.livro.Editora</span></h3>
                </div>
                <div class="section-descriptions-estrelas-paginalivro">
                    <div class="section-descriptions-estrelas-paginalivro-parteEstrela">
                        <img class="section-descriptions-estrelasimg-paginalivro" src="~/img/starComb.png">
                        <div class="section-descriptions-yellowbar-paginalivro" style="width: @((Model.ObterLivro.mediaLivro / 5m * 100).ToString(CultureInfo.InvariantCulture))%;"></div>
                    </div>
                    <h3 class="section-descriptions-avaliados-paginalivro">(@Model.ObterLivro.mediaLivro)</h3>
                    <img class="section-descriptions-setabaixo-paginalivro" src="~/img/setabaixo.png">
                    <h4 class="section-descriptions-qtd-avaliation">(@Model.ObterQuantidadesAvaliacaoLivro.quantidadeG)</h4>
                </div>
                <p class="section-descriptions-text">@Model.ObterLivro.livro.Sinopse</p>
                <h4 class="section-descriptions-relato">Relatar um problema</h4>
                <div class="section-descriptions-divisor"></div>
            </div>
            <div class="section-descriptions-top-prices">
                <h2 class="section-descriptions-top-prices-title">Preço</h2>
                @if(Model.ObterLivro.livro.PromocaoPorcentagem <= 0)
                {
                    <h3 class="section-descriptions-top-prices-original-price"></h3>
                    <h1 class="section-descriptions-top-prices-final-price">R$ <span>@Model.ObterLivro.livro.Preco</span></h1>
                }
                else
                {
                    <h3 class="section-descriptions-top-prices-original-price">R$ @Model.ObterLivro.livro.Preco</h3>
                    <h1 class="section-descriptions-top-prices-final-price">R$ <span>@(Math.Round(decimal.Parse(Model.ObterLivro.livro.Preco, new CultureInfo("pt-BR")) * (1 - Model.ObterLivro.livro.PromocaoPorcentagem / 100m), 2).ToString("N2", new CultureInfo("pt-BR")))</span></h1>
                }
                
                <div class="section-descriptions-top-prices-cartCamada">
                    <div class="section-descriptions-top-prices-addcartretangulo">
                        <img class="section-descriptions-top-prices-carrinho" src="~/img/cart.png">
                        <h2>Adicionar ao carrinho</h2>
                    </div>
                </div>
                @if (DateTime.Now.TimeOfDay < new TimeSpan(15, 0, 0))
                {
                    <h3 class="section-descriptions-top-prices-dataentrega">ENTREGA GRÁTIS, <span>quarta-feira, @dataMais2Dias.ToString("dd/MM/yyyy")</span></h3>
                    <div class="section-descriptions-top-prices-condicional">
                        <h3 class="section-descriptions-top-prices-condicional-text">Se pedir até às: <span>15:00</span></h3>
                        <a class="section-descriptions-top-prices-condicional-sabermais"> Saber mais</a>
                    </div>
                }
                else
                {
                    <h3 class="section-descriptions-top-prices-dataentrega">ENTREGA GRÁTIS, <span>quarta-feira, @dataMais3Dias.ToString("dd/MM/yyyy")</span></h3>
                    <div class="section-descriptions-top-prices-condicional">
                        <h3 class="section-descriptions-top-prices-condicional-text">Se pedir até às: <span>00:00</span></h3>
                        <a class="section-descriptions-top-prices-condicional-sabermais"> Saber mais</a>
                    </div>
                }

                <div class="section-descriptions-top-prices-quantidade">
                    <h2 class="section-descriptions-top-prices-quantidade-text">Quantidade:</h2>
                    <div class="section-descriptions-top-prices-quantidade-block">
                        <input type="number" class="section-descriptions-top-prices-quantidade-block-input" />
                    </div>
                </div>
                <h4 class="section-descriptions-top-prices-envio">Envio gerenciado pela livraria Legítimo</h4>
                <h4 class="section-descriptions-top-prices-exemplares">
                    @if (Model.ObterLivro.livro.Quantidade <= 20)
                    {
                        <span> Últimos exemplares disponíveis: @Model.ObterLivro.livro.Quantidade</span>            
                    }
                </h4>
                <div class="section-descriptions-top-prices-tagCamada">
                    <div class="section-descriptions-top-prices-addcartretangulo">
                        <img class="section-descriptions-top-prices-tag" src="~/img/icon_buy.png">
                        <h2>Comprar agora</h2>
                    </div>
                </div>
            </div>
        </div>
        <div class="section-descriptions-plusinformations">
            <h2 class="section-descriptions-plusinformations-title">Informações úteis:</h2>
            <section class="section-descriptions-plusinformations-list">
                <div class="section-descriptions-plusinformations-list-part">
                    <img src="~/img/icon_size.png" class="section-descriptions-plusinformations-list-part-image" />
                    <div class="section-descriptions-plusinformations-list-part-texts">
                        <h3 class="section-descriptions-plusinformations-list-part-texts-title">Tamanho do livro</h3>
                        <h4 class="section-descriptions-plusinformations-list-part-texts-value">@Model.ObterLivro.livro.Tamanho</h4>
                    </div>
                </div>
                <div class="section-descriptions-plusinformations-list-part">
                    <img src="~/img/icon_published.png" class="section-descriptions-plusinformations-list-part-image" />
                    <div class="section-descriptions-plusinformations-list-part-texts">
                        <h3 class="section-descriptions-plusinformations-list-part-texts-title">Data de publicação</h3>
                        <h4 class="section-descriptions-plusinformations-list-part-texts-value">@Model.ObterLivro.livro.DataPubli</h4>
                    </div>
                </div>
                <div class="section-descriptions-plusinformations-list-part">
                    <img src="~/img/icon_codBarras.png" class="section-descriptions-plusinformations-list-part-image" />
                    <div class="section-descriptions-plusinformations-list-part-texts">
                        <h3 class="section-descriptions-plusinformations-list-part-texts-title">ISBN-13</h3>
                        <h4 class="section-descriptions-plusinformations-list-part-texts-value">@Model.ObterLivro.livro.ISBN</h4>
                    </div>
                </div>
            </section>
        </div>
        <a class="section-descriptions-wishes">
            <h4 class="section-descriptions-wishes-about">Adicionar à lista de desejos</h4>
        </a>
    </section>
</div>
<div class="main-avaliations">
    <section class="total-view-section">
        <div class="total-view-section-stars">
            <div class="yellowbar" style="width: @((Model.ObterLivro.mediaLivro / 5m * 100).ToString(CultureInfo.InvariantCulture))%;"></div>
            <img class="barimageStar" src="~/img/starComb.png">
        </div>
        <h3 class="total-view-section-points"><span>@Model.ObterLivro.mediaLivro</span> de <span>5</span></h3>
        <h4 class="total-view-section-avaliacoes-feitas">@Model.ObterQuantidadesAvaliacaoLivro.quantidadeG avaliações feitas</h4>
        <div class="total-view-section-avaliacoes-por-star">

            @if (Model.ObterQuantidadesAvaliacaoLivro.quantidadeG > 0)
            {
                <div class="total-view-section-avaliacoes-por-star-block">
                    <h3 class="total-view-section-avaliacoes-por-star-title">5 estrelas</h3>
                    <div class="total-view-section-avaliacoes-por-star-barra">
                        <div class="total-view-section-avaliacoes-por-star-barra-preencher" style="width: @(((decimal)Model.ObterQuantidadesAvaliacaoLivro.nota5 / Model.ObterQuantidadesAvaliacaoLivro.quantidadeG * 100).ToString(CultureInfo.InvariantCulture))%;" id="five"></div>
                    </div>
                    <h3 class="total-view-section-avaliacoes-por-star-porcentagem">@(((decimal)Model.ObterQuantidadesAvaliacaoLivro.nota5 / Model.ObterQuantidadesAvaliacaoLivro.quantidadeG * 100).ToString("0.##")) %</h3>
                </div>

                <div class="total-view-section-avaliacoes-por-star-block">
                    <h3 class="total-view-section-avaliacoes-por-star-title">4 estrelas</h3>
                    <div class="total-view-section-avaliacoes-por-star-barra">
                        <div class="total-view-section-avaliacoes-por-star-barra-preencher" style="width: @(((decimal)Model.ObterQuantidadesAvaliacaoLivro.nota4 / Model.ObterQuantidadesAvaliacaoLivro.quantidadeG * 100).ToString(CultureInfo.InvariantCulture))%;" id="four"></div>
                    </div>
                    <h3 class="total-view-section-avaliacoes-por-star-porcentagem">@(((decimal)Model.ObterQuantidadesAvaliacaoLivro.nota4 / Model.ObterQuantidadesAvaliacaoLivro.quantidadeG * 100).ToString("0.##")) %</h3>
                </div>

                <div class="total-view-section-avaliacoes-por-star-block">
                    <h3 class="total-view-section-avaliacoes-por-star-title">3 estrelas</h3>
                    <div class="total-view-section-avaliacoes-por-star-barra">
                        <div class="total-view-section-avaliacoes-por-star-barra-preencher" style="width: @(((decimal)Model.ObterQuantidadesAvaliacaoLivro.nota3 / Model.ObterQuantidadesAvaliacaoLivro.quantidadeG * 100).ToString(CultureInfo.InvariantCulture))%;" id="three"></div>
                    </div>
                    <h3 class="total-view-section-avaliacoes-por-star-porcentagem">@(((decimal)Model.ObterQuantidadesAvaliacaoLivro.nota3 / Model.ObterQuantidadesAvaliacaoLivro.quantidadeG * 100).ToString("0.##")) %</h3>
                </div>

                <div class="total-view-section-avaliacoes-por-star-block">
                    <h3 class="total-view-section-avaliacoes-por-star-title">2 estrelas</h3>
                    <div class="total-view-section-avaliacoes-por-star-barra">
