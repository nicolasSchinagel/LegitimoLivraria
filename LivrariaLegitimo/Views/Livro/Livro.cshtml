<script>
    const totalList4 = document.querySelector(".div-cards-carousel-total-4");
    const listCards4 = document.querySelectorAll(".div-cards-carousel-index-4");
    const prevlist4 = document.querySelector(".arrow-carousel-left-4");
    const nextlist4 = document.querySelector(".arrow-carousel-right-4");
    const valueMin4 = document.querySelector(".start-page-top-bar-4-1");
    const valueMax4 = document.querySelector(".total-pages-top-bar-4-2");
    const divPartsCard = document.querySelector(".parts-card");



    const lateralBar = document.querySelector('.lateral-bar');
    const lateralBarLeave = document.querySelector('.lateral-bar-userDiv-leave');
    const headerMenu = document.querySelector('.deeper-header-menu-icon');

    const menuAva = document.querySelector('.supercard');
    const backMenuAva = document.querySelector('.background-avaliacao');
    const backAva = document.querySelector('.supercard-avaliacao-bottomButton-back');
    const vamosAva = document.querySelector('.total-view-section-avaliar');


    let indicePage4 = 0;
    let posicaoPage4 = 0;

    lateralBarLeave.addEventListener('click', () => {
        lateralBar.style.left = '-35%';
    });
    headerMenu.addEventListener('click', () => {
        lateralBar.style.left = '0%';
    });
    vamosAva.addEventListener('click', () => {
        console.log("clicou ava");
        menuAva.style.right = '0%';
        backMenuAva.style.display = 'flex';
    });
    console.log(backAva);
    backAva.addEventListener('click', () => {
        menuAva.style.right = '100%';
        backMenuAva.style.display = 'none';
    });



    for (let i = 1; i <= listCards4.length; i++) {
        const pinsindices = document.createElement("div");
        pinsindices.classList.add("part-cards");
        divPartsCard.appendChild(pinsindices);
        console.log("rodado");
    }
    const pinsindices = document.querySelectorAll(".part-cards");

    function atualizarPins() {
        pinsindices.forEach((pin, index) => {
            if (index === indicePage4) {
                pin.classList.add("selected-part");
            }
            else {
                pin.classList.remove("selected-part");
            }
        })
    }

    function atualizarPagina4() {
        console.log('ativado');
        if (indicePage4 >= listCards4.length - 1) {
            nextlist4.style.visibility = 'hidden';
        } else {
            nextlist4.style.visibility = 'visible';
            console.log(listCards4.length);
        }

      
        if (indicePage4 <= 0) {
            prevlist4.style.visibility = 'hidden';
            console.log('ativado prev');
        } else {
            prevlist4.style.visibility = 'visible';
        }
        atualizarPins();
        valueMax4.textContent = listCards4.length;
        valueMin4.textContent = indicePage4 + 1;
    }

    atualizarPagina4();
    prevlist4.addEventListener("click", () => {
        indicePage4 = indicePage4 - 1;
        posicaoPage4 = posicaoPage4 - 100;
        totalList4.style.right = posicaoPage4 + '%';
        atualizarPagina4();
    });
    nextlist4.addEventListener("click", () => {
        indicePage4 = indicePage4 + 1;
        posicaoPage4 = posicaoPage4 + 100;
        totalList4.style.right = posicaoPage4 + '%';
        atualizarPagina4();
    });
    pinsindices.forEach((elemento, index) => {
        elemento.addEventListener("click", () => {
            indicePage4 = index;
            posicaoPage4 = 100 * index;
            totalList4.style.right = posicaoPage4 + '%';
            atualizarPagina4();
            console.log("clicado");
        })
    });
</script>