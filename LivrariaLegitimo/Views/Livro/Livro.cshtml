                        <h4 class="section-descriptions-plusinformations-list-part-texts-value">8532519474</h4>
                    </div>
                </div>
            </section>
        </div>
        <a class="section-descriptions-wishes">
            <h4 class="section-descriptions-wishes-about">Adicionar à lista de desejos</h4>
        </a>
