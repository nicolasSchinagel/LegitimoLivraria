
@model LivrariaLegitimo.ViewModels.LivroViewModel

@{
    var livro = Model.ObterLivro.Value;
    Layout = null;

    int paginaInicial = 1;
    int paginaTotalInicial = 1;

    if (Model.HistoricoE != null)
    {
        var historico = Model.HistoricoE.FirstOrDefault(
            x => x.livro != null &&
                 x.livro.CodigoBarras.ToString() == livro.livro.CodigoBarras.ToString()
        );

        if (historico.livro != null)
        {
            paginaInicial = historico.paginaAtual;
            paginaTotalInicial = historico.paginaTotal;
        }
    }

    int porcentagemInicial = paginaTotalInicial > 0
        ? (int)Math.Round((double)paginaInicial / paginaTotalInicial * 100)
        : 0;

    porcentagemInicial = Math.Clamp(porcentagemInicial, 0, 100);
}

<link rel="stylesheet" href="~/css/ebook.css" asp-append-version="true" />

<main class="leitor-container">

    <!-- BARRA SUPERIOR -->
    <section class="leitor-header">

        <button class="voltar-btn" onclick="history.back()">
            <span>←</span>
            Voltar
        </button>

        <div class="livro-info">
            <h1>@livro.livro.Nome</h1>
            <p>@livro.livro.Autor</p>
        </div>

    </section>

    <!-- CONTEÚDO PRINCIPAL -->
    <section class="leitor-content">

        <!-- LATERAL -->
        <aside class="leitor-sidebar">

            <!-- CAPA -->
            <div class="livro-capa">
                <img src="@livro.arquivoImagem"
                     alt="Capa do livro @livro.livro.Nome">
            </div>

            <!-- PROGRESSO -->
            <div class="progresso-container">

                <div class="progresso-info">
                    <span>Seu progresso</span>
                    <strong id="progresso-porcentagem">@porcentagemInicial%</strong>
                </div>

                <div class="progresso-barra">
                    <div class="progresso-atual"
                         id="progresso-atual"
                         style="width: @(porcentagemInicial)%;">
                    </div>
                </div>

                <p id="progresso-paginas">
                    Página @paginaInicial de @paginaTotalInicial
                </p>

            </div>

            <!-- INFORMAÇÕES DO LIVRO -->
            <div class="livro-detalhes">

                <div class="detalhe-item">
                    <span>Editora</span>
                    <strong>@livro.livro.Editora</strong>
                </div>

                <div class="detalhe-item">
                    <span>Autor</span>
                    <strong>@livro.livro.Autor</strong>
                </div>

            </div>

        </aside>

        <!-- ÁREA DE LEITURA -->
        <section class="area-leitura" id="area-leitura">

            <div class="pdf-container">

                <div id="pdf-pages">
                    <p class="pdf-loading">
                        Carregando seu ebook...
                    </p>
                </div>

            </div>

        </section>

    </section>

</main>

<!-- PDF.JS -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>

<script>

    /* CONFIGURAÇÃO DO PDF.JS */
    pdfjsLib.GlobalWorkerOptions.workerSrc =
        'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';

    /* ELEMENTOS */
    const pdfPages = document.getElementById('pdf-pages');
    const areaLeitura = document.getElementById('area-leitura');

    const progressoAtual = document.getElementById('progresso-atual');
    const progressoPorcentagem = document.getElementById('progresso-porcentagem');
    const progressoPaginas = document.getElementById('progresso-paginas');

    /* CONFIGURAÇÕES */
    const pdfUrl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Url.Content(livro.arquivoEbook)));

    const codBarras = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(livro.livro.CodigoBarras.ToString()));

    const paginaInicial = @paginaInicial;

    let pdfDocument = null;
    let renderVersion = 0;
    let renderTasks = [];

    let paginaAtual = paginaInicial;
    let ultimaPaginaEnviada = '';
    let redimensionamento;
    let verificandoPagina = false;

    /* SALVAR PROGRESSO NO HISTÓRICO */
    async function salvarProgresso() {

        if (!pdfDocument) return;

        const dados = {
            codBarras: codBarras,
            paginaAtual: paginaAtual,
            paginaTotal: pdfDocument.numPages
        };

        const identificador =
            `${dados.paginaAtual}-${dados.paginaTotal}`;

        if (identificador === ultimaPaginaEnviada) {
            return;
        }

        try {

            const resposta = await fetch('/Livro/AtualizarProgressoEbook', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(dados)
            });

            if (!resposta.ok) {
                throw new Error(
                    `Erro ao salvar progresso. Status: ${resposta.status}`
                );
            }

            ultimaPaginaEnviada = identificador;

            console.log('Progresso salvo:', dados);

        }
        catch (erro) {

            console.error('Erro ao salvar progresso:', erro);

        }
    }

    /* ATUALIZAR PROGRESSO */
    function atualizarProgresso(numeroPagina) {

        if (!pdfDocument) return;

        numeroPagina = Math.min(
            Math.max(numeroPagina, 1),
            pdfDocument.numPages
        );

        paginaAtual = numeroPagina;

        const totalPaginas = pdfDocument.numPages;

        const porcentagem = Math.round(
            (numeroPagina / totalPaginas) * 100
        );

        /* PORCENTAGEM */
        progressoPorcentagem.textContent = `${porcentagem}%`;

        /* LARGURA DA BARRA */
        progressoAtual.style.width = `${porcentagem}%`;

        /* PÁGINAS */
        progressoPaginas.textContent =
            `Página ${numeroPagina} de ${totalPaginas}`;

        /* SALVAR HISTÓRICO */
        salvarProgresso();
    }

    /* IDENTIFICAR A PÁGINA VISÍVEL */
    function verificarPaginaVisivel() {

        if (!pdfDocument || verificandoPagina) return;

        verificandoPagina = true;

        const area = areaLeitura.getBoundingClientRect();

        const centroArea = area.top + area.height / 2;

        const paginas = pdfPages.querySelectorAll('.pdf-page');

        let paginaMaisProxima = null;
        let menorDistancia = Infinity;

        paginas.forEach(canvas => {

            const retangulo = canvas.getBoundingClientRect();

            /* VERIFICAR SE A PÁGINA ESTÁ VISÍVEL */
            const visivel =
                retangulo.bottom > area.top &&
                retangulo.top < area.bottom;

            if (!visivel) return;

            /* CALCULAR A DISTÂNCIA ATÉ O CENTRO DA ÁREA */
            const centroPagina =
                retangulo.top + retangulo.height / 2;

            const distancia = Math.abs(
                centroPagina - centroArea
            );

            if (distancia < menorDistancia) {

                menorDistancia = distancia;

                paginaMaisProxima = Number(canvas.dataset.page);

            }

        });

        if (paginaMaisProxima !== null) {
            atualizarProgresso(paginaMaisProxima);
        }

        verificandoPagina = false;
    }

    /* RENDERIZAR PDF */
    async function renderizarPDF() {

        if (!pdfDocument) return;

        const versaoAtual = ++renderVersion;

        /* CANCELAR RENDERIZAÇÕES ANTERIORES */
        renderTasks.forEach(task => {
            task.cancel();
        });

        renderTasks = [];

        /* GUARDAR A PÁGINA ATUAL */
        const paginaRestaurar = paginaAtual;

        pdfPages.innerHTML = '';

        const larguraDisponivel = Math.max(
            areaLeitura.clientWidth - 60,
            100
        );

        const proporcaoTela = Math.min(
            window.devicePixelRatio || 1,
            2
        );

        try {

            for (
                let numeroPagina = 1;
                numeroPagina <= pdfDocument.numPages;
                numeroPagina++
            ) {

                if (versaoAtual !== renderVersion) return;

                const pagina = await pdfDocument.getPage(numeroPagina);

                if (versaoAtual !== renderVersion) return;

                const viewportOriginal = pagina.getViewport({
                    scale: 1
                });

                const escala = Math.min(
                    1.25,
                    larguraDisponivel / viewportOriginal.width
                );

                const viewport = pagina.getViewport({
                    scale: escala
                });

                const canvas = document.createElement('canvas');

                canvas.className = 'pdf-page';
                canvas.dataset.page = numeroPagina;

                const contexto = canvas.getContext('2d');

                canvas.width = Math.floor(
                    viewport.width * proporcaoTela
                );

                canvas.height = Math.floor(
                    viewport.height * proporcaoTela
                );

                canvas.style.width = `${viewport.width}px`;
                canvas.style.height = `${viewport.height}px`;

                pdfPages.appendChild(canvas);

                const renderTask = pagina.render({

                    canvasContext: contexto,

                    viewport: viewport,

                    transform: [
                        proporcaoTela,
                        0,
                        0,
                        proporcaoTela,
                        0,
                        0
                    ]

                });

                renderTasks.push(renderTask);

                await renderTask.promise;

                if (versaoAtual !== renderVersion) return;

            }

            /* RECUPERAR A PÁGINA SALVA */
            const paginaDestino = Math.min(
                Math.max(paginaRestaurar, 1),
                pdfDocument.numPages
            );

            const canvasDestino = pdfPages.querySelector(
                `[data-page="${paginaDestino}"]`
            );

            if (canvasDestino) {

                areaLeitura.scrollTop +=
                    canvasDestino.getBoundingClientRect().top -
                    areaLeitura.getBoundingClientRect().top;

            }

            /* ATUALIZAR PROGRESSO E SALVAR TOTAL REAL */
            atualizarProgresso(paginaDestino);

            console.log('Todas as páginas foram renderizadas!');
            console.log('Página inicial:', paginaDestino);
            console.log('Total de páginas:', pdfDocument.numPages);

        }
        catch (erro) {

            if (erro.name === 'RenderingCancelledException') {
                return;
            }

            console.error('Erro ao renderizar PDF:', erro);

            if (versaoAtual === renderVersion) {

                pdfPages.innerHTML = `
                    <p class="pdf-error">
                        Não foi possível renderizar o ebook.
                    </p>
                `;

            }

        }

    }

    /* CARREGAR PDF */
    async function carregarPDF() {

        try {

            console.log('Caminho do PDF:', pdfUrl);

            if (!pdfUrl) {
                throw new Error('O caminho do PDF está vazio.');
            }

            if (typeof pdfjsLib === 'undefined') {
                throw new Error('A biblioteca PDF.js não foi carregada.');
            }

            pdfPages.innerHTML = `
                <p class="pdf-loading">
                    Carregando seu ebook...
                </p>
            `;

            console.log('Buscando documento PDF...');

            pdfDocument = await pdfjsLib.getDocument({
                url: pdfUrl
            }).promise;

            console.log('PDF carregado com sucesso!');
            console.log('Total de páginas:', pdfDocument.numPages);

            /* VALIDAR PÁGINA SALVA */
            paginaAtual = Math.min(
                Math.max(paginaInicial, 1),
                pdfDocument.numPages
            );

            /* RENDERIZAR E SALVAR O TOTAL REAL */
            await renderizarPDF();

        }
        catch (erro) {

            console.error('Erro ao carregar PDF:', erro);

            pdfPages.innerHTML = `
                <p class="pdf-error">
                    Não foi possível carregar seu ebook.
                </p>
            `;

        }

    }

    /* IDENTIFICAR A PÁGINA DURANTE A ROLAGEM */
    areaLeitura.addEventListener('scroll', () => {

        requestAnimationFrame(() => {
            verificarPaginaVisivel();
        });

    });

    /* REAJUSTAR QUANDO A TELA MUDAR DE TAMANHO */
    window.addEventListener('resize', () => {

        clearTimeout(redimensionamento);

        redimensionamento = setTimeout(() => {

            if (pdfDocument) {
                renderizarPDF();
            }

        }, 300);

    });

    /* INICIALIZAÇÃO */
    carregarPDF();

</script>
