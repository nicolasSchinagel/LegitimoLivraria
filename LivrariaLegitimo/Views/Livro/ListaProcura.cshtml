@using System.Globalization
<link rel="stylesheet" href="~/css/list.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/index.css" asp-append-version="true" />
@model LivrariaLegitimo.ViewModels.LivroViewModel
<div class="div-mainList">
    <section class="div-mainList-section-filtros">
        <h3 class="div-mainList-section-filtros-title">Filtros</h3>
        <div class="div-mainList-section-filtros-generos">
            <h3 class="div-mainList-section-filtros-generos-title">Gêneros</h3>
            <div class="div-mainList-section-filtros-generos-block">
                <input type="checkbox" class="div-mainList-section-filtros-generos-block-square" />
                <h4 class="div-mainList-section-filtros-generos-block-square-title">Fantasia</h4>
            </div>
            <div class="div-mainList-section-filtros-generos-block">
                <input type="checkbox" class="div-mainList-section-filtros-generos-block-square" />
                <h4 class="div-mainList-section-filtros-generos-block-square-title">Aventura</h4>
            </div>
            <div class="div-mainList-section-filtros-generos-block">
                <input type="checkbox" class="div-mainList-section-filtros-generos-block-square" />
                <h4 class="div-mainList-section-filtros-generos-block-square-title">Ficção Científica</h4>
            </div>
            <div class="div-mainList-section-filtros-generos-block">
                <input type="checkbox" class="div-mainList-section-filtros-generos-block-square" />
                <h4 class="div-mainList-section-filtros-generos-block-square-title">História</h4>
            </div>
            <div class="div-mainList-section-filtros-generos-block">
                <input type="checkbox" class="div-mainList-section-filtros-generos-block-square" />
                <h4 class="div-mainList-section-filtros-generos-block-square-title">Romance</h4>
            </div>
            <div class="div-mainList-section-filtros-generos-block">
                <input type="checkbox" class="div-mainList-section-filtros-generos-block-square" />
                <h4 class="div-mainList-section-filtros-generos-block-square-title">Biografia</h4>
            </div>
            <div class="div-mainList-section-filtros-generos-block">
                <input type="checkbox" class="div-mainList-section-filtros-generos-block-square" />
                <h4 class="div-mainList-section-filtros-generos-block-square-title">Autoajuda</h4>
            </div>
            <div class="div-mainList-section-filtros-generos-block">
                <input type="checkbox" class="div-mainList-section-filtros-generos-block-square" />
                <h4 class="div-mainList-section-filtros-generos-block-square-title">Terror</h4>
            </div>
            <div class="div-mainList-section-filtros-generos-block">
                <input type="checkbox" class="div-mainList-section-filtros-generos-block-square" />
                <h4 class="div-mainList-section-filtros-generos-block-square-title">Mistério</h4>
            </div>
            <div class="div-mainList-section-filtros-generos-block">
                <input type="checkbox" class="div-mainList-section-filtros-generos-block-square" />
                <h4 class="div-mainList-section-filtros-generos-block-square-title">Filosofia</h4>
            </div>
            <div class="div-mainList-section-filtros-generos-block">
                <input type="checkbox" class="div-mainList-section-filtros-generos-block-square" />
                <h4 class="div-mainList-section-filtros-generos-block-square-title">Humor</h4>
            </div>
            <div class="div-mainList-section-filtros-generos-block">
                <input type="checkbox" class="div-mainList-section-filtros-generos-block-square" />
                <h4 class="div-mainList-section-filtros-generos-block-square-title">Drama</h4>
            </div>
            <div class="div-mainList-section-filtros-generos-block">
                <input type="checkbox" class="div-mainList-section-filtros-generos-block-square" />
                <h4 class="div-mainList-section-filtros-generos-block-square-title">Suspense</h4>
            </div>
            <div class="div-mainList-section-filtros-generos-block">
                <input type="checkbox" class="div-mainList-section-filtros-generos-block-square" />
                <h4 class="div-mainList-section-filtros-generos-block-square-title">Religião</h4>
            </div>
            <div class="div-mainList-section-filtros-generos-block">
                <input type="checkbox" class="div-mainList-section-filtros-generos-block-square" />
                <h4 class="div-mainList-section-filtros-generos-block-square-title">Literatura Clássica</h4>
            </div>
            <div class="div-mainList-section-filtros-generos-block">
                <input type="checkbox" class="div-mainList-section-filtros-generos-block-square" />
                <h4 class="div-mainList-section-filtros-generos-block-square-title">Literatura Infantil</h4>
            </div>
            <div class="div-mainList-section-filtros-generos-block">
                <input type="checkbox" class="div-mainList-section-filtros-generos-block-square" />
                <h4 class="div-mainList-section-filtros-generos-block-square-title">Literatura Juvenil</h4>
            </div>
            <div class="div-mainList-section-filtros-generos-block">
                <input type="checkbox" class="div-mainList-section-filtros-generos-block-square" />
                <h4 class="div-mainList-section-filtros-generos-block-square-title">Contos</h4>
            </div>
            <div class="div-mainList-section-filtros-generos-block">
                <input type="checkbox" class="div-mainList-section-filtros-generos-block-square" />
                <h4 class="div-mainList-section-filtros-generos-block-square-title">Poesia</h4>
            </div>
            <div class="div-mainList-section-filtros-generos-block">
                <input type="checkbox" class="div-mainList-section-filtros-generos-block-square" />
                <h4 class="div-mainList-section-filtros-generos-block-square-title">Mangás</h4>
            </div>
        </div>
        <div class="div-mainList-section-filtros-faixapreco">
            <h3 class="div-mainList-section-filtros-faixapreco-title">Faixa de Preço</h3>
            <div class="parte-de-ate">
                <div class="div-mainList-section-filtros-faixapreco-de">
                    <h4 class="div-mainList-section-filtros-faixapreco-de-text">De:</h4>
                    <input type="number" class="div-mainList-section-filtros-faixapreco-de-input" />
                </div>
                <div class="div-mainList-section-filtros-faixapreco-de">
                    <h4 class="div-mainList-section-filtros-faixapreco-de-text">Até:</h4>
                    <input type="number" class="div-mainList-section-filtros-faixapreco-de-input" />
                </div>
            </div>
        </div>
        <div class="div-mainList-section-filtros-avaliacao-selector">
            <h3 class="div-mainList-section-filtros-avaliacao-selector-title">Avaliação</h3>
            <div class="parte-de-ate-avaliacao">
                <div class="div-mainList-section-filtros-avaliacao-selector-de">
                    <h4 class="div-mainList-section-filtros-avaliacao-selector-de-text">De:</h4>
                    <input type="number" class="div-mainList-section-filtros-avaliacao-selector-de-input" />
                </div>
                <div class="div-mainList-section-filtros-avaliacao-selector-starList">
                    <img src="./imagens/StarComb.png" class="div-mainList-section-filtros-avaliacao-selector-starList-starborder" />
                    <div class="div-mainList-section-filtros-avaliacao-selector-starList-yellow"></div>
                </div>
            </div>
            <div class="parte-de-ate-avaliacao">
                <div class="div-mainList-section-filtros-avaliacao-selector-de">
                    <h4 class="div-mainList-section-filtros-avaliacao-selector-de-text">Até:</h4>
                    <input type="number" class="div-mainList-section-filtros-avaliacao-selector-de-input" />
                </div>
                <div class="div-mainList-section-filtros-avaliacao-selector-starList">
                    <img src="./imagens/StarComb.png" class="div-mainList-section-filtros-avaliacao-selector-starList-starborder" />
                    <div class="div-mainList-section-filtros-avaliacao-selector-starList-yellow"></div>
                </div>
            </div>
        </div>
        <div class="div-mainList-section-filtros-tipoLivro">
            <h3 class="div-mainList-section-filtros-generos-title">Tipo de livro</h3>
            <div class="div-mainList-section-filtros-generos-block">
                <input type="checkbox" class="div-mainList-section-filtros-generos-block-square" />
                <h4 class="div-mainList-section-filtros-generos-block-square-title">Capa mole</h4>
            </div>
            <div class="div-mainList-section-filtros-generos-block">
                <input type="checkbox" class="div-mainList-section-filtros-generos-block-square" />
                <h4 class="div-mainList-section-filtros-generos-block-square-title">Capa dura</h4>
            </div>
            <div class="div-mainList-section-filtros-generos-block">
                <input type="checkbox" class="div-mainList-section-filtros-generos-block-square" />
                <h4 class="div-mainList-section-filtros-generos-block-square-title">Ebook</h4>
            </div>
        </div>
    </section>
    <section class="div-mainList-section-lista">
        @foreach(var livro in Model.TodosLivros)
        {
            <div class="card1-2" 
                 data-generos="@string.Join("|", livro.livro.Generos)"
                 data-preco="@livro.livro.Preco"
                 data-avaliacao="@(Convert.ToDouble(livro.mediaLivro))"
                 data-tipo="@livro.livro.TipoCapa"
                 data-ebook="@(!string.IsNullOrEmpty(livro.arquivoEbook))"
                 data-nome="@livro.livro.Nome"
                 data-autor="@livro.livro.Autor"
                 data-editora="@livro.livro.Editora"
                 data-idioma="@livro.livro.Idioma"
                 data-literatura="@livro.livro.Literatura"
                 data-data-publi="@livro.livro.DataPubli.ToString("yyyy-MM-dd")"
                 data-idade-recomendada="@livro.livro.IdadeRecomendada"
                 data-promocao="@livro.livro.PromocaoPorcentagem"
                 data-quantidade="@livro.livro.Quantidade"
                 data-capacidade="@livro.livro.Capacidade"
                 data-isbn="@livro.livro.ISBN"
                 data-codigo-barras="@livro.livro.CodigoBarras"
                 data-tamanho="@livro.livro.Tamanho"
                 data-vendas="@livro.numeroVendas">
                <div class="containerlivro">
                    <img class="book" src="@livro.arquivoImagem">

                    <div class="retangulocima">
                        <img class="imgetiqueta" src="~/img/iconefogo.png">
                        <p class="alta">EM ALTA</p>
                    </div>
                </div>


                <div class="partebaixo">
                    <div class="tituloeheart">
                        <h2 class="titulolivro">@(livro.livro.Nome.Length > 37 ? livro.livro.Nome.Substring(0, 37) + "..." : livro.livro.Nome)</h2>
                        <div class="heartfundo">
                            <img class="heart" src="~/img/coracaored.png">
                        </div>
                    </div>

                    <p class="autor">Por @livro.livro.Autor</p>
                    <p class="editor">@livro.livro.Editora</p>
                    <div class="estrelas">
                        <div class="estrelas-specifics">
                            <img class="estrelasimg" src="~/img/StarComb.png">
                            <div class="estrelas-specifics-yellowbar" style="width: @((livro.mediaLivro / 5m * 100).ToString(CultureInfo.InvariantCulture))%;"></div>
                        </div>
                        <h3 class="avaliados">(@(livro.mediaLivro))</h3>
                        <img class="setabaixo" src="~/img/setabaixo.png">
                    </div>
                    @if (livro.livro.PromocaoPorcentagem <= 0)
                    {
                        <h3 class="precoog"></h3>
                    }
                    else
                    {
                        <h3 class="precoog">R$ @livro.livro.Preco</h3>
                    }
                    <div class="precoDiv">
                        @if (livro.livro.PromocaoPorcentagem <= 0)
                        {
                            <h2 class="preco">R$ @livro.livro.Preco</h2>
                            <h2 class="off"></h2>
                        }
                        else
                        {
                            <h2 class="preco">
                                R$ @(Math.Round(decimal.Parse(livro.livro.Preco, new CultureInfo("pt-BR")) * (1 - livro.livro.PromocaoPorcentagem / 100m), 2).ToString("N2", new CultureInfo("pt-BR")))
                            </h2>
                            <h2 class="off">@livro.livro.PromocaoPorcentagem% OFF</h2>
                        }
                    </div>
                </div>
                <div class="cartCamada">
                    <div class="addcartretangulo">
                        <img class="carrinho" src="~/img/cart.png">
                        <h2>Adicionar ao carrinho</h2>
                    </div>
                </div>
            </div>
        }

    </section>
</div>
<script src="~/js/filtroLivros.js" asp-append-version="true"></script>