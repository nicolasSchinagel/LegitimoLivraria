@model IEnumerable<LivrariaLegitimo.Models.Funcionario>;

<link rel="stylesheet" href="~/css/funcionarios.css" asp-append-version="true" />
<main class="funcionarios-container">

    <section class="funcionarios-titulo">
        <h1>Funcionários da Livraria</h1>
        <p>
            Lista de funcionários da livraria para verificar dados a alterá-los caso necessário
        </p>
    </section>

    <section class="funcionarios-tabela">

        <div class="funcionarios-tabela-header">
            <div>Nome do funcionário</div>
            <div>CPF</div>
            <div>Cargo</div>
            <div>Ação</div>
        </div>

        <div class="funcionarios-tabela-corpo">

            
            @foreach(var funcionario in Model)
            {
                <div class="funcionarios-linha">
                    <div class="funcionarios-nome">@funcionario.Nome</div>
                    <div class="funcionarios-cpf">@funcionario.Cpf</div>
                    <div class="funcionarios-cargo">@funcionario.Cargo</div>
                    <div class="funcionarios-acao">
                        <a class="no-underline">Editar</a>
                    </div>
                </div>
            }

        </div>

    </section>

</main>
