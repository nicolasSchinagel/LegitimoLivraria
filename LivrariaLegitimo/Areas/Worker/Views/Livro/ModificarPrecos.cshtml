@using System.Globalization
@model LivrariaLegitimo.ViewModels.LivroViewModel

<link rel="stylesheet" href="~/css/modificarPrecos.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/adicionarLivro.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/reposicao.css" asp-append-version="true" />
<div class="precos-pagina">

    <section class="addLivro-main-header">
        <img src="./imagens/precoEmblema.png" class="addLivro-main-header-img" />
        <div class="addLivro-main-header-texts">
            <h1 class="addLivro-main-header-title">Modificar Preços</h1>
            <h3 class="addLivro-main-header-subtitle">Altere preços e adicione promoções para aumentar as vendas de livros</h3>
        </div>
    </section>

    <div class="precos-card">

        <h2 class="precos-busca-label">Pesquisar um livro para alterar</h2>
        <form class="precos-busca-input-wrap" method="get" asp-area="Worker" asp-controller="Livro" asp-action="ModificarPrecos">
            <button class="main-reposicao-search-icon" type="submit" aria-label="Pesquisar">
            <img class="precos-busca-icone" src="./imagens/SearchbarIcon.png">
            </button>
            <input type="text" class="precos-busca-input" name="pesquisa" placeholder="Pesquisar por título, autor, editora ou ISBN...">
        </form>

        <h3 class="precos-secao-label">SELECIONE um livro</h3>

        <div class="precos-resultados-grid">
            @foreach(var livro in Model.TodosLivros)
            {
                <div class="resultado-livro">
                    <img class="resultado-capa" src="@livro.arquivoImagem">
                    <div class="resultado-info">
                        <h4 class="resultado-titulo">@livro.livro.Nome</h4>
                        <p class="resultado-autor">@livro.livro.Autor</p>
                        <p class="resultado-isbn">ISBN: @livro.livro.ISBN</p>
                        <p class="resultado-editora">@livro.livro.Editora</p>
                        @if (livro.livro.PromocaoPorcentagem == 0)
                        {
                            <div class="resultado-precolinha">
                                <span class="resultado-precoog"></span>
                                <span class="resultado-off"></span>
                            </div>
                            <span class="resultado-precofinal">R$ @livro.livro.Preco</span>
                        }
                        else
                        {
                            <div class="resultado-precolinha">
                                <span class="resultado-precoog">R$ @livro.livro.Preco</span>
                                <span class="resultado-off">23% OFF</span>
                            </div>
                            <span class="resultado-precofinal">R$ @(Math.Round(decimal.Parse(livro.livro.Preco, new CultureInfo("pt-BR")) * (1 - livro.livro.PromocaoPorcentagem / 100m), 2).ToString("N2", new CultureInfo("pt-BR")))</span>

                        }
                        <div class="main-reposicao-livro-avaliacao-estrelas">
                            <div class="estrelas">
                                <div class="estrelas-specifics">
                                    <img class="estrelasimg" src="~/img/StarComb.png">
                                    <div class="estrelas-specifics-yellowbar" style="width: @((livro.mediaLivro / 5m * 100).ToString(CultureInfo.InvariantCulture))%;"></div>
                                </div>
                                <h3 class="avaliados-historico">(@(livro.mediaLivro))</h3>
                                <img class="setabaixo" src="~/img/setabaixo.png">
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>


        <p class="precos-sem-resultado">Nenhum livro encontrado.</p>

        <h3 class="precos-secao-label">LIVRO SELECIONADO</h3>

        <div class="precos-selecionado-painel">
            <div class="precos-selecionado-textos">
                <h2 class="precos-selecionado-titulo">@Model.ObterLivro.livro.Nome</h2>
                <p class="precos-selecionado-autor">@Model.ObterLivro.livro.Autor</p>
                <p class="precos-selecionado-isbn">Código de Barras: @Model.ObterLivro.livro.CodigoBarras</p>
                <p class="precos-selecionado-editora">@Model.ObterLivro.livro.Editora</p>
                <div class="main-reposicao-livro-avaliacao-estrelas">
                    <div class="estrelas">
                        <div class="estrelas-specifics">
                            <img class="estrelasimg" src="~/img/StarComb.png">
                            <div class="estrelas-specifics-yellowbar" style="width: @((Model.ObterLivro.mediaLivro / 5m * 100).ToString(CultureInfo.InvariantCulture))%;"></div>
                        </div>
                        <h3 class="avaliados-historico">(@(Model.ObterLivro.mediaLivro))</h3>
                        <img class="setabaixo" src="~/img/setabaixo.png">
                    </div>
                </div>
            </div>

            <form class="precos-inputs" methpd="post" asp-controller="Livro" asp-action="ModificarPrecos">
                <div class="precos-input-linha">
                    <div class="precos-input-grupo">
                        <label for="precoOriginal">Preço original</label>
                        <div class="precos-input-com-prefixo">
                            <span>R$</span>
                            <input type="text" asp-for="ObterLivro.livro.Preco" name="preco" id="precoOriginal" inputmode="decimal">
                        </div>
                    </div>
                    <div class="precos-input-grupo">
                        <label for="precoFinal">Preço final</label>
                        <div class="precos-input-com-prefixo">
                            <span>R$</span>
                            <input type="text" id="precoFinal" inputmode="decimal" readonly>
                        </div>
                    </div>
                </div>

                <div class="precos-input-grupo">
                    <label for="taxaDesconto">Taxa de desconto</label>
                    <div class="precos-input-com-prefixo">
                        <input type="text" asp-for="ObterLivro.livro.PromocaoPorcentagem" name="promocao" id="taxaDesconto" inputmode="decimal">
                        <span>%</span>
                    </div>
                </div>
                <input type="text" name="codBarras" value="@Model.ObterLivro.livro.CodigoBarras" inputmode="decimal" hidden>
                <input type="text" name="nome" value="@Model.ObterLivro.livro.Nome" inputmode="decimal" hidden>

                <button class="precos-confirmar-btn" type="submit">CONFIRMAR ALTERAÇÕES</button>
            </form>

            <img class="precos-selecionado-capa" src="@Model.ObterLivro.arquivoImagem">
        </div>

    </div>
</div>
<script>
    const precoOriginal = document.getElementById("precoOriginal");
    const precoFinal = document.getElementById("precoFinal");
    const taxaDesconto = document.getElementById("taxaDesconto");

    function converterValor(valor) {
        return parseFloat(valor.replace(",", "."));
    }

    function formatarValor(valor) {
        return valor.toFixed(2).replace(".", ",");
    }

    // Alterando o preço original ou a taxa, calcula o preço final
    function calcularPrecoFinal() {
        let original = converterValor(precoOriginal.value);
        let desconto = converterValor(taxaDesconto.value);

        if (isNaN(original) || isNaN(desconto) || original <= 0) {
            precoFinal.value = "";
            return;
        }

        let final = original - (original * desconto / 100);

        precoFinal.value = formatarValor(final);
    }

    // Alterando o preço original ou o preço final, calcula a taxa
    function calcularTaxaDesconto() {
        let original = converterValor(precoOriginal.value);
        let final = converterValor(precoFinal.value);

        if (isNaN(original) || isNaN(final) || original <= 0) {
            taxaDesconto.value = "";
            return;
        }

        let desconto = ((original - final) / original) * 100;

        taxaDesconto.value = formatarValor(desconto);
    }

    precoOriginal.addEventListener("input", () => {
        if (taxaDesconto.value !== "") {
            calcularPrecoFinal();
        } else {
            calcularTaxaDesconto();
        }
    });

    precoFinal.addEventListener("input", calcularTaxaDesconto);

    taxaDesconto.addEventListener("input", calcularPrecoFinal);
</script>